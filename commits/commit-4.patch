diff --git a/src/utils/accessibility.js b/src/utils/accessibility.js
new file mode 100644
index 0000000..21af9a0
--- /dev/null
+++ b/src/utils/accessibility.js
@@ -0,0 +1,21 @@
+export function prefersReducedMotion() {
+  return typeof window !== "undefined" && window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+}
+
+const TUTORIAL_KEY = "greedyPig.tutorialSeen";
+
+export function hasSeenTutorial() {
+  try {
+    return localStorage.getItem(TUTORIAL_KEY) === "1";
+  } catch {
+    return true; // storage blocked: don't nag every time
+  }
+}
+
+export function markTutorialSeen() {
+  try {
